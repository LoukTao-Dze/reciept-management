{
  "name": "receipt-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start:dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start:dev --workspace backend",
    "start:backend:dev": "npm run start:dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "test": "npm run test --workspace frontend && npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
